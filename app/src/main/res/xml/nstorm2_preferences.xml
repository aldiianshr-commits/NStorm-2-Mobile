<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Mesin emulasi" app:iconSpaceReserved="false">
        <ListPreference
            app:key="engine"
            app:title="Mesin"
            app:defaultValue="arm64ec"
            app:entries="@array/nstorm_engine_entries"
            app:entryValues="@array/nstorm_engine_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="box64_preset"
            app:title="Preset Box64 (hanya mesin x86-64)"
            app:defaultValue="INTERMEDIATE"
            app:entries="@array/nstorm_box64_entries"
            app:entryValues="@array/nstorm_box64_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Grafis" app:iconSpaceReserved="false">
        <ListPreference
            app:key="gpu_driver"
            app:title="Driver GPU Vulkan"
            app:defaultValue="turnip25.3.0_R3_Auto"
            app:entries="@array/nstorm_gpu_entries"
            app:entryValues="@array/nstorm_gpu_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="dxvk_version"
            app:title="Versi DXVK (Direct3D 11 → Vulkan)"
            app:defaultValue="auto"
            app:entries="@array/nstorm_dxvk_entries"
            app:entryValues="@array/nstorm_dxvk_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="dxvk_async"
            app:title="Kompilasi shader asinkron"
            app:summary="Mengurangi patah-patah saat efek jurus pertama kali muncul. Hanya berlaku untuk build DXVK Async/GPL-Async."
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="resolution"
            app:title="Resolusi"
            app:defaultValue="1280x800"
            app:entries="@array/nstorm_resolution_entries"
            app:entryValues="@array/nstorm_resolution_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="stretch"
            app:title="Regangkan ke layar penuh"
            app:summary="Mati: rasio aspek dipertahankan (ada bilah hitam jika rasio berbeda)."
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="frame_sync"
            app:title="Sinkronisasi frame"
            app:defaultValue="Normal"
            app:entries="@array/nstorm_framesync_entries"
            app:entryValues="@array/nstorm_framesync_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="turnip_sysmem"
            app:title="Mode render sysmem Turnip"
            app:summary="Lebih stabil bila ada artefak grafis, tetapi lebih lambat dari mode GMEM bawaan."
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Performa" app:iconSpaceReserved="false">
        <ListPreference
            app:key="fps_limit"
            app:title="Batas FPS"
            app:defaultValue="60"
            app:entries="@array/nstorm_fps_entries"
            app:entryValues="@array/nstorm_fps_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="show_fps"
            app:title="Tampilkan penghitung FPS"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="cpu_cores"
            app:title="Inti CPU untuk game"
            app:defaultValue="4,5,6,7"
            app:entries="@array/nstorm_cpu_entries"
            app:entryValues="@array/nstorm_cpu_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="vram_limit"
            app:title="Batas memori video"
            app:defaultValue="0"
            app:entries="@array/nstorm_vram_entries"
            app:entryValues="@array/nstorm_vram_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="audio_driver"
            app:title="Driver audio"
            app:defaultValue="alsa-reflector"
            app:entries="@array/nstorm_audio_entries"
            app:entryValues="@array/nstorm_audio_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Kontrol" app:iconSpaceReserved="false">
        <ListPreference
            app:key="control_mode"
            app:title="Mode kontrol"
            app:defaultValue="auto"
            app:entries="@array/nstorm_control_entries"
            app:entryValues="@array/nstorm_control_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="overlay_opacity"
            app:title="Transparansi tombol sentuh (%)"
            app:defaultValue="45"
            app:min="10"
            android:max="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Peluncuran &amp; Steam" app:iconSpaceReserved="false">
        <ListPreference
            app:key="launch_mode"
            app:title="Cara menjalankan"
            app:defaultValue="direct"
            app:entries="@array/nstorm_launch_entries"
            app:entryValues="@array/nstorm_launch_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="steam_path"
            app:title="Lokasi steam.exe di dalam Wine"
            app:defaultValue="C:\\Program Files (x86)\\Steam\\steam.exe"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="steam_delay"
            app:title="Jeda sebelum game dijalankan (detik)"
            app:defaultValue="30"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="steam_appid_file"
            app:title="Buat steam_appid.txt (543870)"
            app:summary="Cara resmi Steamworks agar game yang dibuka manual memakai klien Steam yang sedang berjalan. Kepemilikan tetap diperiksa Steam."
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Lanjutan" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="save_sync"
            app:title="Sinkronisasi save ke /nstorm2/saves"
            app:summary="Salin save dari/ke folder penyimpanan internal setiap kali game dibuka dan ditutup."
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            app:key="extra_env"
            app:title="Variabel lingkungan tambahan"
            app:summary="Contoh: DXVK_HUD=fps,gpuload BOX64_DYNAREC_BIGBLOCK=0"
            app:defaultValue=""
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
