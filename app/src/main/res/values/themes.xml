<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NStorm" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/ns_accent</item>
        <item name="colorPrimaryVariant">@color/ns_accent_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/ns_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">@color/ns_accent</item>
        <item name="colorSurface">@color/ns_surface</item>
        <item name="colorOnSurface">@color/ns_text</item>
        <item name="android:colorBackground">@color/ns_bg</item>
        <item name="android:windowBackground">@color/ns_bg</item>
        <item name="android:statusBarColor">@color/ns_bg</item>
        <item name="android:navigationBarColor">@color/ns_bg</item>
        <item name="android:textColorPrimary">@color/ns_text</item>
        <item name="android:textColorSecondary">@color/ns_muted</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.Dialog.Alert</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.NStorm.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="NS.Section" parent="">
        <item name="android:textColor">@color/ns_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="NS.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ns_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ns_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="NS.Action" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ns_text</item>
        <item name="strokeColor">@color/ns_stroke</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="iconTint">@color/ns_accent</item>
        <item name="iconPadding">12dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="NS.Chip" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/ns_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="backgroundTint">#CC161C30</item>
        <item name="cornerRadius">18dp</item>
    </style>
</resources>
