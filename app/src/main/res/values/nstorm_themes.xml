<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NStorm" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/nstorm_accent</item>
        <item name="colorPrimaryVariant">@color/nstorm_accent_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/nstorm_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">@color/nstorm_accent</item>
        <item name="colorSurface">@color/nstorm_surface</item>
        <item name="colorOnSurface">@color/nstorm_text</item>
        <item name="android:colorBackground">@color/nstorm_bg</item>
        <item name="android:windowBackground">@color/nstorm_bg</item>
        <item name="android:statusBarColor">@color/nstorm_bg</item>
        <item name="android:navigationBarColor">@color/nstorm_bg</item>
        <item name="android:textColorPrimary">@color/nstorm_text</item>
        <item name="android:textColorSecondary">@color/nstorm_text_muted</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.Dialog.Alert</item>
    </style>

    <style name="Theme.NStorm.Settings">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="NStorm.SectionTitle" parent="">
        <item name="android:textColor">@color/nstorm_accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="NStorm.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/nstorm_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/nstorm_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="NStorm.StatusLabel" parent="">
        <item name="android:textColor">@color/nstorm_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="NStorm.StatusValue" parent="">
        <item name="android:textColor">@color/nstorm_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="NStorm.ActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/nstorm_text</item>
        <item name="strokeColor">@color/nstorm_stroke</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="iconTint">@color/nstorm_accent</item>
        <item name="iconPadding">12dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
